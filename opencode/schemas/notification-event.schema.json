{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pai.notification-event.v1",
  "title": "PAI Notification Event",
  "type": "object",
  "required": [
    "v",
    "timestamp",
    "level",
    "event",
    "session_id",
    "slug",
    "title",
    "speak",
    "language",
    "data"
  ],
  "properties": {
    "v": { "const": 1 },
    "timestamp": { "type": "string" },
    "level": { "enum": ["milestone", "attention", "digest"] },
    "event": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "slug": { "type": ["string", "null"] },
    "title": { "type": ["string", "null"] },
    "speak": { "type": "string", "maxLength": 200 },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "data": { "type": "object" }
  }
}
