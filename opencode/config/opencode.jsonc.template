{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["./plugins/pai-hooks.js"],
  // PAI is model-agnostic: no primary model is hardcoded here. install.sh injects
  // a "model" line below from PAI/USER/Config/primary-model (per-machine choice).
  // Without that file, no "model" key is emitted and OpenCode uses your globally
  // configured model. Subagents omit `model` too, so they inherit this primary.
  // PAI_MODEL_INJECTION_POINT
  // PAI Mode/Tier Classifier Configuration.
  // LLM classification is ON by default, matching original PAI's model-first
  // classifier. Set PAI_CLASSIFIER_USE_LLM=false only for offline/debug runs.
  //   PAI_CLASSIFIER_MODEL=<provider/model>  — default: current OpenCode bench
  //                                           model env, else opencode/deepseek-v4-flash-free
  //   PAI_CLASSIFIER_TIMEOUT_MS=25000        — Timeout in milliseconds
  // If the LLM classifier fails/timeouts, fail-safe is ALGORITHM E3 (matching
  // original PAI). The heuristic path is used only when LLM is explicitly off.
  "default_agent": "build",
  "skills": {
    "paths": ["~/.config/opencode/skills"]
  },
  "reference": {
    "PAI": { "path": "~/.config/opencode/PAI" }
  },
  "instructions": ["~/.config/opencode/PAI/CLAUDE.md"],
  "agent": {
    "build": {
      "description": "Default PAI primary agent for normal OpenCode prompts",
      "mode": "primary",
      "prompt": "You are the primary PAI Digital Assistant inside OpenCode. PAI is the default behavior; the user does not need to type /pai. Follow the PAI runtime context injected by the pai-hooks plugin, honor MODE/TIER classification, use NATIVE for simple tasks, and enter the Algorithm for complex or multi-step work. Prefer OpenCode-native tools and ${PAI_DIR} paths. Before the final user-facing response for completed work, call pai_notify exactly once with message and language (pt-BR for Portuguese, en-US for English); then repeat the same sentence in the visible 🎯 COMPLETED line."
    },
    "build-mobile": {
      "description": "PAI primary agent tuned for mobile clients — lean delivery, same discipline",
      "mode": "primary",
      "prompt": "You are the primary PAI Digital Assistant inside OpenCode, serving a MOBILE client on a small screen. Same PAI behavior and discipline as the default agent — honor MODE/TIER classification, use NATIVE for simple tasks, enter the Algorithm for complex or multi-step work, keep ISA and phase discipline — but with a LEAN delivery profile: answer directly and concisely; no decorative output sections (no STORY EXPLANATION, no multi-block emoji headers); short paragraphs over long lists; preserve everything structural. Before the final user-facing response for completed work, call pai_notify exactly once with message and language (pt-BR for Portuguese, en-US for English); then repeat the same sentence in the visible 🎯 COMPLETED line."
    }
  },
  "permission": {
    "read": {
      "~/.config/opencode/PAI/**": "allow",
      "~/.config/opencode/skills/**": "allow",
      "~/.config/opencode/agents/**": "allow",
      "~/.config/opencode/commands/**": "allow",
      "~/Projects/**": "allow",
      "~/projects/**": "allow",
      "~/dev/**": "allow",
      "~/workspace/**": "allow",
      "~/work/**": "allow",
      "~/code/**": "allow",
      "~/src/**": "allow",
      "/tmp/**": "allow"
    },
    "edit": {
      "~/.config/opencode/PAI/MEMORY/**": "allow",
      "~/.config/opencode/PAI/logs/**": "allow",
      "~/.config/opencode/PAI/USER/**": "ask",
      "~/.config/opencode/plugins/**": "ask",
      "~/.config/opencode/agents/**": "ask",
      "~/.config/opencode/commands/**": "ask",
      "~/.config/opencode/opencode.jsonc": "ask",
      "~/Projects/**": "allow",
      "~/projects/**": "allow",
      "~/dev/**": "allow",
      "~/workspace/**": "allow",
      "~/work/**": "allow",
      "~/code/**": "allow",
      "~/src/**": "allow",
      "/tmp/**": "allow"
    },
    "bash": {
      // Original-PAI posture (Releases/v5.0.0 settings.json: Bash in allow,
      // deny/ask empty): allow by default. Protection is the deterministic
      // deny floor in the PAI plugin (tool.execute.before) + the alert audit
      // trail — not approval prompts the user stops reading. Ask is reserved
      // for genuine boundary crossings so the rare prompt gets read.
      "*": "allow",
      "sudo *": "ask",
      "rm -f ~/.config/opencode/plugins/pai-hooks.lib.js": "ask"
    },
    "external_directory": {
      "~/.config/opencode/PAI/**": "allow",
      "~/.config/opencode/skills/**": "allow",
      "~/.config/opencode/agents/**": "allow",
      "~/.config/opencode/commands/**": "allow",
      "~/.config/opencode/plugins/**": "allow",
      "~/Projects/**": "allow",
      "~/projects/**": "allow",
      "~/dev/**": "allow",
      "~/workspace/**": "allow",
      "~/work/**": "allow",
      "~/code/**": "allow",
      "~/src/**": "allow",
      "/tmp/**": "allow"
    }
  },
  "command": {
    "pai": {
      "template": "Execute the PAI Algorithm for: $ARGUMENTS",
      "description": "Start the PAI Algorithm",
      "agent": "Algorithm"
    },
    "status": {
      "template": "Report PAI system status: active sessions, memory state, installed agents, installed skills, and pending actions. Treat Pulse as optional scaffolding only; do not classify missing localhost:31337 health surfaces as install failure unless the user explicitly says they enabled or expect a live Pulse daemon.",
      "description": "Show PAI system status",
      "agent": "build"
    },
    "interview": {
      "template": "Begin the PAI onboarding or refresh interview. Capture TELOS, ideal state, preferences, identity, missing context, and the prompt-classifier model.",
      "description": "Run PAI onboarding interview",
      "agent": "build"
    },
    "classifier": {
      "template": "Set or update the prompt-classifier model for this machine. Discover the real available models, ask which to use and whether to run the LLM classifier, then write the classifier config.",
      "description": "Set the prompt-classifier model",
      "agent": "build"
    },
    "pulse": {
      "template": "Inspect Pulse scaffolding and, if a live daemon is explicitly configured by the user, summarize its health. Otherwise report whether only static Pulse config is installed and avoid calling that degraded.",
      "description": "Inspect Pulse scaffold or runtime",
      "agent": "build"
    },
    "context": {
      "template": "Search PAI context for: $ARGUMENTS",
      "description": "Search prior PAI context",
      "agent": "build"
    },
    "context-search": {
      "template": "Perform a 2-phase PAI context search across the session registry, work directories, and ISAs for: $ARGUMENTS",
      "description": "Search PAI session registry, work dirs, and ISAs",
      "agent": "build"
    },
    "cs": {
      "template": "Perform a 2-phase PAI context search across the session registry, work directories, and ISAs for: $ARGUMENTS",
      "description": "Alias for /context-search",
      "agent": "build"
    },
    "pu": {
      "template": "Check PAI Pulse status and metrics. Report whether only static Pulse scaffolding is installed; do not treat a missing localhost:31337 daemon as a failure.",
      "description": "Check PAI Pulse status and metrics",
      "agent": "build"
    },
    "voice": {
      "template": "Manage the PAI desktop voice using ~/.config/opencode/PAI/bin/voice-config.sh. If $ARGUMENTS is empty, run `~/.config/opencode/PAI/bin/voice-config.sh show` and `~/.config/opencode/PAI/bin/voice-config.sh list pt-BR`, present the numbered voices, and ask which one to save. If $ARGUMENTS is `on`, run `~/.config/opencode/PAI/bin/voice-config.sh on`. If $ARGUMENTS is `off`, run `~/.config/opencode/PAI/bin/voice-config.sh off`. If $ARGUMENTS is `test`, run `~/.config/opencode/PAI/bin/voice-config.sh test`. If $ARGUMENTS is a voice name, run `~/.config/opencode/PAI/bin/voice-config.sh set $ARGUMENTS`, then tell the user that voice on/off applies immediately to the built-in renderer and voice changes apply on the next spoken line.",
      "description": "Choose the PAI desktop voice",
      "agent": "build"
    },

    "e1": {
      "template": "Run PAI effort E1 for: $ARGUMENTS",
      "description": "PAI Standard effort",
      "agent": "build"
    },
    "e2": {
      "template": "Run PAI effort E2 for: $ARGUMENTS",
      "description": "PAI Extended effort",
      "agent": "build"
    },
    "e3": {
      "template": "Run PAI effort E3 for: $ARGUMENTS",
      "description": "PAI Advanced effort",
      "agent": "build"
    },
    "e4": {
      "template": "Run PAI effort E4 for: $ARGUMENTS",
      "description": "PAI Deep effort",
      "agent": "build"
    },
    "e5": {
      "template": "Run PAI effort E5 for: $ARGUMENTS",
      "description": "PAI Comprehensive effort",
      "agent": "build"
    }
  }
}
