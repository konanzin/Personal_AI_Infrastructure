{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@pai/shared-types": ["../../packages/shared-types/src"],
      "@pai/shared-schemas": ["../../packages/shared-schemas/src"],
      "@pai/ui-system": ["../../packages/ui-system/src"],
      "@pai/opencode-mobile-client": ["../../packages/opencode-mobile-client/src"],
      "@pai/audio-elevenlabs": ["../../packages/audio-elevenlabs/src"]
    },
    "noEmit": true
  },
  "references": [
    { "path": "../../packages/shared-types" },
    { "path": "../../packages/shared-schemas" },
    { "path": "../../packages/ui-system" },
    { "path": "../../packages/opencode-mobile-client" },
    { "path": "../../packages/audio-elevenlabs" }
  ],
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
